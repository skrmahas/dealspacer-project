# PostgreSQL (required)
DATABASE_URL=postgresql://user:password@localhost:5432/bei

# OpenAI API key (required for GPT-4o extraction)
OPENAI_API_KEY=sk-...

# Optional: directory for uploaded files and generated reports
# Defaults to ./data relative to this package
DATA_DIR=./data

# Optional: worker polling interval in milliseconds
WORKER_POLL_INTERVAL_MS=2000

# Optional: how often to sweep stale in-progress jobs, in milliseconds
STALE_JOB_SWEEP_INTERVAL_MS=30000

# Optional: jobs older than this threshold in non-terminal states are reset to pending
STALE_JOB_THRESHOLD_MS=1800000
