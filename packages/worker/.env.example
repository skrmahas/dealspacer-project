# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/bei

# OpenAI API key (required for GPT-4o extraction and translation)
OPENAI_API_KEY=***

# ── File storage ─────────────────────────────────────────────────────────────
# Local disk directory for uploaded files and generated reports
# Only used when S3 is not configured. Default: ./bei-data
DATA_DIR=./bei-data

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
# Set S3_BUCKET to enable S3 mode; unset all S3 vars to use local disk
#S3_BUCKET=bei-files
#S3_ENDPOINT=https://abc123.r2.cloudflarestorage.com
#S3_REGION=auto
#S3_ACCESS_KEY_ID=***
#S3_SECRET_ACCESS_KEY=***
#S3_FORCE_PATH_STYLE=false

# ── Worker polling ───────────────────────────────────────────────────────────
# How often the worker polls for new pending jobs (ms). Default: 2000
#WORKER_POLL_INTERVAL_MS=2000

# Stale-job recovery sweep interval (ms). Default: 30000
#STALE_JOB_SWEEP_INTERVAL_MS=30000

# Jobs stuck in non-terminal states longer than this are reset to pending (ms).
# Default: 1800000 (30 minutes)
#STALE_JOB_THRESHOLD_MS=1800000

# ── PDF parsing ──────────────────────────────────────────────────────────────
# Parallel page extraction batch size. Default: 8
#WORKER_PDF_BATCH_SIZE=8

# OCR per-page timeout (ms). Pages exceeding this are skipped. Default: 30000
#OCR_PAGE_TIMEOUT_MS=30000

# ── GPT-4o extraction ────────────────────────────────────────────────────────
# Character threshold before chunked parallel extraction activates. Default: 60000
#EXTRACTION_CHUNK_THRESHOLD=60000

# Chunk size for parallel extraction. Default: 50000
#EXTRACTION_CHUNK_SIZE=50000

# Overlap between extraction chunks. Default: 5000
#EXTRACTION_CHUNK_OVERLAP=5000

# Max concurrent extraction calls (preferred key). Default: 1
#LLM_EXTRACTION_CONCURRENCY=1

# Legacy alias for extraction concurrency (used only if LLM_EXTRACTION_CONCURRENCY is unset)
#EXTRACTION_MAX_CONCURRENCY=1

# Max retries on transient API errors (429, 5xx, network). 0 = no retries. Default: 3
#EXTRACTION_MAX_RETRIES=3

# ── PDF rendering ────────────────────────────────────────────────────────────
# Remote browser WebSocket endpoint (alternative to local Chromium)
#PUPPETEER_BROWSER_WS_ENDPOINT=ws://...

# Remote browser URL (connect mode)
#PUPPETEER_BROWSER_URL=http://...

# Path to Chrome/Chromium executable (bypasses bundled binary)
#PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Enable Puppeteer debug logging (1 = enabled)
#PUPPETEER_DEBUG=0

# PDF rendering scale. Values <1 produce more compact PDFs. Default: 1.0
#PUPPETEER_PDF_SCALE=1.0

# Path to Ghostscript binary for PDF post-compression (optional)
#GHOSTSCRIPT_PATH=/usr/bin/gs

# ── Worker runtime ───────────────────────────────────────────────────────────
# Max memory threshold (MB). Warning logged if RSS exceeds this. Default: none
#WORKER_MAX_RSS_MB=1024

# Grace period for in-flight job completion during shutdown (ms). Default: 120000
#WORKER_SHUTDOWN_GRACE_MS=120000
