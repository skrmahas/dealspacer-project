# Copy this file to .env in this directory (loaded by the worker on startup).
# DATABASE_URL, DATA_DIR, and S3 settings must match packages/web/.env.local

# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bei:bei@localhost:5432/bei

# OpenAI API key (extraction and translation)
OPENAI_API_KEY=

# ── File storage (local dev — leave S3 commented out) ───────────────────────
DATA_DIR=./bei-data

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, etc.)
# Uncomment and fill to use cloud storage instead of DATA_DIR
#S3_BUCKET=
#S3_ENDPOINT=
#S3_REGION=auto
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_FORCE_PATH_STYLE=false

# ── Optional: OpenAI model ───────────────────────────────────────────────────
# Default is gpt-4o-mini (higher TPM/RPM on typical tiers). Override for stronger reasoning:
#OPENAI_MODEL=gpt-4o

# ── Extraction throttling / retries (429 rate limits) ─────────────────────────
# Sleep between chunk API calls (ms). Helps stay under RPM when processing large PDFs (default 0).
#EXTRACTION_INTER_CHUNK_DELAY_MS=800
#EXTRACTION_MAX_RETRIES=6
#RETRY_BASE_DELAY_MS=2000
#RETRY_MAX_DELAY_MS=60000

# ── Extraction performance (large PDFs use chunking above EXTRACTION_CHUNK_THRESHOLD) ──
# Parallel chunk workers (default 1). Raise to 2–4 if your OpenAI tier allows higher RPM/TPM.
#EXTRACTION_MAX_CONCURRENCY=2
# Fewer, larger chunks = fewer round-trips (watch context size and rate limits).
#EXTRACTION_CHUNK_SIZE=100000
#EXTRACTION_CHUNK_OVERLAP=4000

# ── Worker polling ───────────────────────────────────────────────────────────
#WORKER_POLL_INTERVAL_MS=2000
#STALE_JOB_SWEEP_INTERVAL_MS=30000
#STALE_JOB_THRESHOLD_MS=1800000
#WORKER_HEALTH_PORT=8080

# ── PDF / Puppeteer (optional) ───────────────────────────────────────────────
#PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
#PUPPETEER_PDF_SCALE=1.0
