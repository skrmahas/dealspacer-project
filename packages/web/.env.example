# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (shared with worker)
DATABASE_URL=postgresql://user:password@localhost:5432/bei

# ── File storage ─────────────────────────────────────────────────────────────
# Local disk directory for uploaded files and generated reports
# Only used when S3 is not configured. Default: ./bei-data
DATA_DIR=./bei-data

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
# Set S3_BUCKET to enable S3 mode; unset all S3 vars to use local disk
# Must match the worker's S3 configuration.
#S3_BUCKET=bei-files
#S3_ENDPOINT=https://abc123.r2.cloudflarestorage.com
#S3_REGION=auto
#S3_ACCESS_KEY_ID=***
#S3_SECRET_ACCESS_KEY=***
#S3_FORCE_PATH_STYLE=false

# ── Access gate ──────────────────────────────────────────────────────────────
# Access code required to enter the web UI. If unset, the access page shows
# an error in production.
#ACCESS_CODE=demo

# Cookie name for access code. Default: bei_access
#ACCESS_CODE_COOKIE_NAME=bei_access
