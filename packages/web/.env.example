# Copy this file to .env.local (recommended) or .env in this directory.
# Next.js loads .env, .env.local, and .env.development automatically.
# Values must match packages/worker/.env for DATABASE_URL, storage, and S3.

# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL (use docker compose up -d at repo root, or your own instance)
DATABASE_URL=postgresql://bei:bei@localhost:5432/bei

# Access code for /access gate (any string for local dev)
BEI_ACCESS_CODE=demo

# ── File storage (local dev — leave S3 commented out) ───────────────────────
DATA_DIR=./bei-data

# S3-compatible storage — optional; must match worker if enabled
#S3_BUCKET=
#S3_ENDPOINT=
#S3_REGION=auto
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_FORCE_PATH_STYLE=false

# ── Optional ─────────────────────────────────────────────────────────────────
#ACCESS_RATE_LIMIT_MAX=10
#ACCESS_RATE_LIMIT_WINDOW_MS=60000
